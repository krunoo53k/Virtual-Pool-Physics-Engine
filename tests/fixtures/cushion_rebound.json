{
  "id": "cushion_rebound",
  "title": "Cushion rebound for a rolling, spinless ball",
  "purpose": "Validates the Han impulse model (doc section 5.1). The incidence angle is measured from the rail normal, so 0 deg is a square hit. The second block pins the vertical flip between the normal impulse (into the slate) and the friction impulse (upward), which is what produces the hop.",
  "sources": [
    "doc sections 5.1 and 8.1",
    "Mathavan et al. 2010, Figs. 8-10"
  ],
  "setup": {
    "balls": [
      {
        "id": "b0",
        "position": [
          0.5,
          0.5
        ],
        "velocity": [
          2.0,
          0.0
        ],
        "angular_velocity": [
          0.0,
          69.9912510936133,
          0.0
        ]
      }
    ],
    "params": {
      "nose_apex_height": 0.0363,
      "nose_arc_radius": 0.00635,
      "e_cushion": 0.75,
      "mu_cushion": 0.14,
      "derived_eps_over_R": 0.03937007874015742
    },
    "note": "the incoming velocity makes `incidence_angle` with the rail normal (+x); the ball is rolling, so omega = (k x v)/R"
  },
