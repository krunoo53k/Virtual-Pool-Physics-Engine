  "invariants": [
    {
      "quantity": "rebound_angle_independence",
      "statement": "the rebound angle is identical for incident speeds of 1, 2 and 4 m/s at the same incidence angle (Mathavan Fig. 8)",
      "tolerance": 1e-09,
      "unit": "deg"
    },
    {
      "quantity": "max_speed_loss_near_40deg",
      "statement": "the speed loss is largest for incidence angles around 40 deg (Mathavan, section 4)",
      "tolerance": 0.02,
      "unit": "m/s"
    },
    {
      "quantity": "vertical_flip_threshold",
      "statement": "the outgoing vertical velocity changes sign at eps_c/R = mu_cushion/sqrt(1 + mu_cushion^2) = 0.139 for mu_cushion = 0.14; above it the ball is pressed into the slate, below it the ball is launched upward. The WPA reference profile derives eps = 0.039 R and must therefore launch the ball upward",
      "tolerance": 1e-09,
      "unit": "m/s"
    },
    {
      "quantity": "eps_derived_from_nose_geometry",
      "statement": "the contact height comes from the line of centres: eps = R*(apex - arc_radius - z_c)/(R + arc_radius), where z_c is the ball's centre height at the contact, so it is an output of the profile and of the ball's state rather than a tuned input",
      "tolerance": 1e-09,
      "unit": "m"
    },
    {
      "quantity": "eps_independent_of_approach_angle",
      "statement": "eps depends only on z_c: the nose is a cylinder along the rail, so the contact normal has no component along the rail and a 40 degree approach gives the same eps as a square hit at the same z_c",
      "tolerance": 1e-09,
      "unit": "m"
    },
    {
      "quantity": "normal_flips_for_a_lifted_ball",
      "statement": "with the ball's centre 20 mm above the bed, eps is negative (-0.533 R) and the normal points away from the rail and UP, so the cushion pushes the ball up as well as back",
      "tolerance": 1e-09,
      "unit": "m"
    }
  ]
}
