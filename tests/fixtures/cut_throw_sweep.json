{
  "id": "cut_throw_sweep",
  "title": "Object-ball throw versus cut angle and shot speed",
  "purpose": "Validates the 1/7 sticking constant, the Coulomb cap on the tangential impulse and the speed-dependent friction coefficient. Every row is at one of TP A.14's own speeds, so that the model and the measurement beside it are the same shot. Also records a known model limitation (see known_deviations).",
  "sources": [
    "Alciatore, 'The Amazing World of Billiards Physics' (2007), TP A-14 throw data",
    "doc section 4.4.5"
  ],
  "setup": {
    "balls": [
      {
        "id": "cue",
        "position": [
          0.0,
          0.0
        ],
        "velocity": [
          2.0,
          0.0
        ],
        "angular_velocity": [
          0.0,
          0.0,
          0.0
        ]
      },
      {
        "id": "object",
        "position": [
          0.3,
          0.0
        ],
        "velocity": [
          0.0,
          0.0
        ],
        "angular_velocity": [
          0.0,
          0.0,
          0.0
        ]
      }
    ],
    "params": {
      "e_ball": 0.95,
      "mu_ball": 0.05,
      "note": "object ball placed along the cut-angle bisector per row; the cue ball is spinless, so the slip is purely horizontal and the slip speed is the cue ball's speed times sin(cut)"
    }
  },
  "expectations": [
    {
      "cut_angle": 10,
      "cue_speed": 0.4472,
      "measured_speed": "slow",
      "model_throw_deg": -1.4799,
      "regime": "sticking",
      "measured_throw_deg": 1.45
    },
    {
