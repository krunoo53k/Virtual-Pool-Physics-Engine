  "expectations": [
    {
      "quantity": "final_state_hash",
      "expected": "f9821109f3c622f4",
      "tolerance": 0,
      "notes": "the golden value: the hash of the canonical byte form of the final state of the break shot below - the raw f64 positions, velocities and angular velocities, the discrete states, the phase, the flags and the elapsed time. The generator writes null here; this value was written by hand and must survive a regeneration. It changed three times. Once when the vertical spin decay was fixed to stop at zero (see the note in the model): the balls used to run away with a backspin that never died, and the shot never came to rest. Once when the test that rejects a contact below the nose was given a tolerance: a ball that rests on the bed touches the nose at exactly the nose height, so a ball whose height came from a single-precision number was a fraction of a nanometre off and went through the rail instead of bouncing off it. And once when the friction between two balls was put in the whole tangent plane and made to fall with the sliding speed (doc section 4.4.5): the throw of every collision changed, and so did every ball's path after it."
    },
    {
      "quantity": "hash_stability",
      "statement": "the hash must be identical across repeated runs, across thread counts, and across x86-64 / ARM / wasm targets",
      "tolerance": 0
    },
    {
      "quantity": "event_order_stability",
      "statement": "the sequence of resolved events must be identical between runs; equal-time events are broken by ball index",
      "tolerance": 0
    }
  ],
  "notes": [
    "The hash must be computed over the raw f64 state (position, velocity, angular velocity) - not over a formatted or rounded representation.",
    "Do not include wall-clock time, iteration order of any hash map, or thread scheduling in the hashed state."
  ]
